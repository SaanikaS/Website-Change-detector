  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "pixelmatch": "^6.0.0",
    "playwright": "1.50.1",
    "pngjs": "^7.0.0"
  }
