# ---- Server ----
PORT=3000
# Public URL of this app (used for diff links inside alerts)
BASE_URL=http://localhost:3000
# Where the SQLite DB and screenshots are stored
DATA_DIR=./data
# Protects the dashboard + API. Leave empty ONLY on a private machine.
ADMIN_TOKEN=change-me
# Identify your bot politely to the sites you monitor
USER_AGENT=WebsiteChangeDetector/1.0 (+https://github.com/YOUR-USER/website-change-detector)

# ---- Politeness / reliability ----
WORKER_CONCURRENCY=2
# Minimum gap between two requests to the same host (ms)
HOST_MIN_GAP_MS=10000
NAV_TIMEOUT_MS=30000
JOB_TIMEOUT_MS=90000
JOB_MAX_ATTEMPTS=3
# Alert that a page is down/blocked only after this many failed checks in a row
FAILURE_ALERT_THRESHOLD=3
# Minimum minutes between two change alerts for the same monitor (extra changes are batched)
ALERT_COOLDOWN_MIN=30
SNAPSHOT_RETENTION=100
# Hide carousels/sliders/tickers (rotating banners) before extracting text
HIDE_ROTATORS=true
# Server-local hour (0-23) when daily digests are sent
DIGEST_HOUR=8
# Set true ONLY for local testing against localhost/private IPs
ALLOW_PRIVATE_HOSTS=false
# Set 1 when running as root in Docker
CHROMIUM_NO_SANDBOX=0

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Telegram (optional): create a bot with @BotFather ----
TELEGRAM_BOT_TOKEN=

# ---- AI one-line change summaries (optional bonus) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
